diff --git a/QuickLook/BridgeServer.cs b/QuickLook/BridgeServer.cs
new file mode 100644
index 0000000..ca6eca4
--- /dev/null
+++ b/QuickLook/BridgeServer.cs
@@ -0,0 +1,117 @@
+// GPL-3.0-or-later. Versioned, acknowledged bridge for maintained QuickLook.
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.IO.Pipes;
+using System.Security.AccessControl;
+using System.Security.Principal;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json.Linq;
+namespace QuickLook;
+
+public static class BridgeIdentity
+{
+#if KATRAN_BRIDGE_LAB
+    public static bool Lab { get; } = true;
+    public const string Mutex = "QuickLook.KatranBridge.Lab.Mutex";
+    public const string LegacyPrefix = "QuickLook.KatranBridge.Lab.Legacy.";
+    public const string BridgePrefix = "QuickLook.KatranBridge.Lab.v1.";
+#else
+    public static bool Lab { get; } = false;
+    public const string Mutex = "QuickLook.App.Mutex";
+    public const string LegacyPrefix = "QuickLook.App.Pipe.";
+    public const string BridgePrefix = "QuickLook.KatranBridge.v1.";
+#endif
+}
+
+public sealed class BridgeServer : IDisposable
+{
+    public static BridgeServer Instance { get; private set; }
+    public static bool Ready { get; set; }
+    public const int MaxFrame = 131072;
+    private readonly string name;
+    private readonly Func<string, Task> dispatch;
+    private readonly CancellationTokenSource stop = new CancellationTokenSource();
+    private readonly object gate = new object();
+    private readonly Dictionary<string,JObject> results = new Dictionary<string,JObject>();
+    private readonly Dictionary<string,string> paths = new Dictionary<string,string>();
+    private readonly Queue<string> order = new Queue<string>();
+    private NamedPipeServerStream active;
+    private readonly Task worker;
+    private readonly string nonce = Guid.NewGuid().ToString("N");
+    private int disposed, pending;
+    public static void Start(Func<string,Task> dispatch) { Instance = new BridgeServer(BridgeIdentity.BridgePrefix + WindowsIdentity.GetCurrent().User.Value, dispatch); }
+    public BridgeServer(string name, Func<string,Task> dispatch) { this.name=name; this.dispatch=dispatch; worker=Task.Run(Run); }
+    private JObject Response(string state,bool ok=true,string id=null,string error=null) { return new JObject { ["protocol"]=1,["ok"]=ok,["state"]=state,["request_id"]=id,["error"]=error,["pid"]=Process.GetCurrentProcess().Id,["instance"]=nonce,["version"]="4.4.0-katran-bridge1" }; }
+    private JObject Handle(JObject request)
+    {
+        if ((int?)request["protocol"]!=1) return Response("rejected",false,error:"unsupported_protocol");
+        string command=(string)request["command"];
+        if(command=="status") return Response(Ready ? "ready":"initializing");
+        string id=(string)request["request_id"];
+        if(string.IsNullOrWhiteSpace(id)||id.Length>128) return Response("rejected",false,error:"invalid_request_id");
+        if(command=="request_status") {lock(gate){return results.TryGetValue(id,out var old)?(JObject)old.DeepClone():Response("unknown",false,id,"unknown_request");}}
+        if(command!="preview") return Response("rejected",false,id,"unknown_command");
+        string path=(string)request["path"];
+        if(path==null||path.Length>32767||path.IndexOfAny(new[]{'\0','\r','\n','|'})>=0||!Path.IsPathRooted(path)||!File.Exists(path)) return Response("rejected",false,id,"invalid_path");
+        lock(gate)
+        {
+            if(results.TryGetValue(id,out var old)) return paths[id]==path?(JObject)old.DeepClone():Response("rejected",false,id,"request_id_conflict");
+            if(!Ready) return Response("rejected",false,id,"not_ready");
+            if(pending>=4) return Response("rejected",false,id,"queue_full");
+            // Completed outcomes can be evicted; in-flight requests are retained.
+            while(order.Count>=256){string first=order.Dequeue();if((string)results[first]["state"]=="accepted"){order.Enqueue(first);continue;}results.Remove(first);paths.Remove(first);break;}
+            results[id]=Response("accepted",true,id);paths[id]=path;order.Enqueue(id);pending++;
+        }
+        _ = Dispatch(id,path);
+        lock(gate) return (JObject)results[id].DeepClone();
+    }
+    private async Task Dispatch(string id,string path)
+    {
+        JObject result;
+        try { await dispatch(path).ConfigureAwait(false); result=Response("dispatched",true,id); }
+        catch(Exception e) { result=Response("failed",false,id,e.GetType().Name+": "+e.Message); }
+        lock(gate){results[id]=result;pending--;}
+    }
+    private NamedPipeServerStream Create()
+    {
+        var security=new PipeSecurity();security.SetAccessRuleProtection(true,false);
+        security.AddAccessRule(new PipeAccessRule(WindowsIdentity.GetCurrent().User,PipeAccessRights.FullControl,AccessControlType.Allow));
+        return new NamedPipeServerStream(name,PipeDirection.InOut,1,PipeTransmissionMode.Byte,PipeOptions.Asynchronous,4096,4096,security);
+    }
+    private async Task Run()
+    {
+        while(!stop.IsCancellationRequested)
+        {
+            NamedPipeServerStream pipe=null;
+            try {
+                pipe=Create();lock(gate){if(stop.IsCancellationRequested){pipe.Dispose();return;}active=pipe;}
+                await pipe.WaitForConnectionAsync(stop.Token).ConfigureAwait(false);
+                var work=Serve(pipe);
+                if(await Task.WhenAny(work,Task.Delay(2000,stop.Token)).ConfigureAwait(false)!=work){pipe.Dispose();}
+                try{await work.ConfigureAwait(false);}catch(Exception e){Debug.WriteLine(e);}
+            }catch(Exception e){Debug.WriteLine(e);if(!stop.IsCancellationRequested)await Task.Delay(20).ConfigureAwait(false);}
+            finally {lock(gate){if(ReferenceEquals(active,pipe))active=null;}if(pipe!=null){try{if(pipe.IsConnected)pipe.Disconnect();}catch(Exception e){Debug.WriteLine(e);}pipe.Dispose();}}
+        }
+    }
+    private async Task ReadExact(Stream stream,byte[] bytes)
+    {int pos=0;while(pos<bytes.Length){int n=await stream.ReadAsync(bytes,pos,bytes.Length-pos,stop.Token).ConfigureAwait(false);if(n==0)throw new EndOfStreamException();pos+=n;}}
+    private async Task Serve(Stream pipe)
+    {
+        var header=new byte[4];await ReadExact(pipe,header).ConfigureAwait(false);
+        int n=BitConverter.ToInt32(header,0);if(n<=0||n>MaxFrame)throw new InvalidDataException("Frame limit");
+        var payload=new byte[n];await ReadExact(pipe,payload).ConfigureAwait(false);
+        JObject response;
+        try{var text=new UTF8Encoding(false,true).GetString(payload);using(var reader=new Newtonsoft.Json.JsonTextReader(new StringReader(text))){reader.MaxDepth=16;var request=JObject.Load(reader);if(reader.Read())throw new InvalidDataException("Trailing JSON");response=Handle(request);}}
+        catch(Exception e){response=Response("rejected",false,error:e.GetType().Name);}
+        byte[] answer=new UTF8Encoding(false).GetBytes(response.ToString(Newtonsoft.Json.Formatting.None));
+        byte[] length=BitConverter.GetBytes(answer.Length);await pipe.WriteAsync(length,0,4,stop.Token).ConfigureAwait(false);await pipe.WriteAsync(answer,0,answer.Length,stop.Token).ConfigureAwait(false);
+        // Keep the server connection alive until the reader consumes the frame
+        // and closes. DisconnectNamedPipe would otherwise discard buffered ACK.
+        await pipe.ReadAsync(new byte[1],0,1,stop.Token).ConfigureAwait(false);
+    }
+    public void Dispose(){if(Interlocked.Exchange(ref disposed,1)!=0)return;stop.Cancel();lock(gate){active?.Dispose();}if(!worker.Wait(3000))throw new TimeoutException("Bridge did not stop");stop.Dispose();}
+}
diff --git a/QuickLook/HardenedPipeReceiver.cs b/QuickLook/HardenedPipeReceiver.cs
new file mode 100644
index 0000000..2e26307
--- /dev/null
+++ b/QuickLook/HardenedPipeReceiver.cs
@@ -0,0 +1,91 @@
+// GPL-3.0-or-later; isolated QuickLook latency experiment.
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.IO.Pipes;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+namespace QuickLook;
+
+// One bounded newline-terminated UTF-8 message per connection. EOF is never a command.
+public sealed class HardenedPipeReceiver : IDisposable
+{
+    public const int MaximumBytes = 131072;
+    private readonly string name;
+    private readonly Func<string, bool> received;
+    private readonly CancellationTokenSource stop = new CancellationTokenSource();
+    private readonly object gate = new object();
+    private NamedPipeServerStream active;
+    private readonly Task worker;
+    private int disposed;
+    public HardenedPipeReceiver(string name, Func<string, bool> received)
+    {
+        this.name = name; this.received = received;
+        worker = Task.Run(Run);
+    }
+    private async Task Run()
+    {
+        while (!stop.IsCancellationRequested)
+        {
+            NamedPipeServerStream pipe = null;
+            try
+            {
+                pipe = new NamedPipeServerStream(name, PipeDirection.In, 1,
+                    PipeTransmissionMode.Byte, PipeOptions.Asynchronous);
+                lock (gate) { if (stop.IsCancellationRequested) { pipe.Dispose(); return; } active = pipe; }
+                await pipe.WaitForConnectionAsync(stop.Token).ConfigureAwait(false);
+                var read = ReadLine(pipe);
+                if (await Task.WhenAny(read, Task.Delay(1000, stop.Token)).ConfigureAwait(false) != read)
+                {
+                    pipe.Dispose();
+                    try { await read.ConfigureAwait(false); } catch (Exception e) { Debug.WriteLine(e); }
+                    continue;
+                }
+                string line = await read.ConfigureAwait(false);
+                if (line != null && received(line)) return;
+            }
+            catch (Exception e)
+            { Debug.WriteLine(e); }
+            finally
+            {
+                lock (gate) { if (ReferenceEquals(active, pipe)) active = null; }
+                if (pipe != null)
+                {
+                    try { if (pipe.IsConnected) pipe.Disconnect(); } catch (IOException) { }
+                    catch (ObjectDisposedException) { }
+                    pipe.Dispose();
+                }
+            }
+        }
+    }
+    private async Task<string> ReadLine(NamedPipeServerStream pipe)
+    {
+        var bytes = new byte[MaximumBytes]; int used = 0;
+        var buffer = new byte[1024];
+        while (used < bytes.Length)
+        {
+            int n = await pipe.ReadAsync(buffer, 0, Math.Min(buffer.Length, bytes.Length-used), stop.Token).ConfigureAwait(false);
+            if (n == 0) return null;
+            for (int i=0; i<n; i++)
+            {
+                if (buffer[i] == 10)
+                {
+                    if (used == 0) return null;
+                    if (bytes[used-1] == 13) used--;
+                    return new UTF8Encoding(false, true).GetString(bytes, 0, used);
+                }
+                bytes[used++] = buffer[i];
+            }
+        }
+        return null;
+    }
+    public void Dispose()
+    {
+        if (Interlocked.Exchange(ref disposed, 1) != 0) return;
+        stop.Cancel();
+        lock (gate) { active?.Dispose(); }
+        if (!worker.Wait(3000)) throw new TimeoutException("Lab receiver did not stop");
+        stop.Dispose();
+    }
+}
